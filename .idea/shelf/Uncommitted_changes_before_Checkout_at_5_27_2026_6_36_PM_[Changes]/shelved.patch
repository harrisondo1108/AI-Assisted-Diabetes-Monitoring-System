<+><!DOCTYPE html>\r\n<html lang=\"vi\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>Lab Test Management</title>\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n\r\n    <!-- Font -->\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\"\r\n          rel=\"stylesheet\">\r\n\r\n    <!-- Font Awesome -->\r\n    <link rel=\"stylesheet\"\r\n          href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css\">\r\n\r\n    <!-- CSS -->\r\n    <link rel=\"stylesheet\"\r\n          href=\"/css.pages/lab-test-page.css\"\r\n          th:href=\"@{/css.pages/lab-test-page.css}\">\r\n</head>\r\n\r\n<body>\r\n\r\n<div class=\"page-layout\">\r\n\r\n    <!-- SIDEBAR -->\r\n    <aside class=\"sidebar\">\r\n\r\n        <div>\r\n            <div class=\"brand\">\r\n                <h1>MetabolicCare</h1>\r\n                <p>Admin Console</p>\r\n            </div>\r\n\r\n            <nav class=\"nav-menu\">\r\n\r\n                <a href=\"#\" class=\"nav-link\">\r\n                    <i class=\"fa-solid fa-table-cells-large\"></i>\r\n                    <span>Dashboard</span>\r\n                </a>\r\n\r\n                <a href=\"#\" class=\"nav-link\">\r\n                    <i class=\"fa-solid fa-users\"></i>\r\n                    <span>User Management</span>\r\n                </a>\r\n\r\n                <a href=\"#\" class=\"nav-link\">\r\n                    <i class=\"fa-solid fa-briefcase-medical\"></i>\r\n                    <span>Medicine Management</span>\r\n                </a>\r\n\r\n                <a href=\"/admin/lab-tests\"\r\n                   th:href=\"@{/admin/lab-tests}\"\r\n                   class=\"nav-link active\">\r\n                    <i class=\"fa-solid fa-microscope\"></i>\r\n                    <span>Lab Tests</span>\r\n                </a>\r\n\r\n                <a href=\"#\" class=\"nav-link\">\r\n                    <i class=\"fa-solid fa-sliders\"></i>\r\n                    <span>Threshold Config</span>\r\n                </a>\r\n\r\n                <a href=\"#\" class=\"nav-link\">\r\n                    <i class=\"fa-solid fa-chart-line\"></i>\r\n                    <span>Monitoring</span>\r\n                </a>\r\n\r\n            </nav>\r\n        </div>\r\n\r\n        <div class=\"sidebar-footer\">\r\n\r\n            <button type=\"button\" class=\"new-report-btn\">\r\n                <i class=\"fa-solid fa-plus\"></i>\r\n                <span>New Report</span>\r\n            </button>\r\n\r\n            <a href=\"#\" class=\"footer-link\">\r\n                <i class=\"fa-solid fa-gear\"></i>\r\n                <span>Settings</span>\r\n            </a>\r\n\r\n            <a href=\"#\" class=\"footer-link\">\r\n                <i class=\"fa-regular fa-circle-question\"></i>\r\n                <span>Support</span>\r\n            </a>\r\n\r\n        </div>\r\n\r\n    </aside>\r\n\r\n    <!-- MAIN -->\r\n    <main class=\"main\">\r\n\r\n        <!-- TOP BAR -->\r\n        <header class=\"topbar\">\r\n\r\n            <div class=\"top-search\">\r\n                <i class=\"fa-solid fa-magnifying-glass\"></i>\r\n                <input type=\"text\" placeholder=\"Search lab tests or results...\">\r\n            </div>\r\n\r\n            <div class=\"user-area\">\r\n\r\n                <button type=\"button\" class=\"notification-btn\">\r\n                    <i class=\"fa-regular fa-bell\"></i>\r\n                    <span></span>\r\n                </button>\r\n\r\n                <div class=\"divider\"></div>\r\n\r\n                <div class=\"user-info\">\r\n                    <h4>Dr. Julian Vance</h4>\r\n                    <p>Chief Administrator</p>\r\n                </div>\r\n\r\n                <img src=\"https://i.pravatar.cc/100?img=12\"\r\n                     alt=\"avatar\"\r\n                     class=\"avatar\">\r\n            </div>\r\n\r\n        </header>\r\n\r\n        <!-- CONTENT -->\r\n        <section class=\"content\">\r\n\r\n            <!-- Breadcrumb -->\r\n            <div class=\"breadcrumb\">\r\n                <span>Admin</span>\r\n                <span>/</span>\r\n                <strong>Laboratory Test Catalog</strong>\r\n            </div>\r\n\r\n            <!-- Page Header -->\r\n            <div class=\"page-header\">\r\n\r\n                <div>\r\n                    <h2>Lab Test Management</h2>\r\n                    <p>Configure diagnostic parameters and view clinical lab results.</p>\r\n                </div>\r\n\r\n                <div class=\"page-actions\">\r\n\r\n                    <a href=\"/admin/lab-tests/export\"\r\n                       th:href=\"@{/admin/lab-tests/export}\"\r\n                       class=\"btn btn-outline\">\r\n                        <i class=\"fa-solid fa-download\"></i>\r\n                        <span>Export Data</span>\r\n                    </a>\r\n\r\n                    <button type=\"button\" class=\"btn btn-primary\" id=\"btnDefineNewTest\">\r\n                        <i class=\"fa-regular fa-circle-plus\"></i>\r\n                        <span>Define New Test</span>\r\n                    </button>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n            <!-- Tabs -->\r\n            <div class=\"tabs\">\r\n                <button type=\"button\"\r\n                        class=\"tab active\"\r\n                        data-tab=\"catalog\">\r\n                    Test Catalog\r\n                </button>\r\n\r\n                <button type=\"button\"\r\n                        class=\"tab\"\r\n                        data-tab=\"results\">\r\n                    Patient Lab Results\r\n                </button>\r\n            </div>\r\n\r\n            <!-- CATALOG -->\r\n            <div class=\"card tab-content active\" id=\"catalog\">\r\n\r\n                <div class=\"card-header\">\r\n                    <h3>Test Definitions</h3>\r\n\r\n                    <button type=\"button\" class=\"filter-btn\">\r\n                        <i class=\"fa-solid fa-filter\"></i>\r\n                    </button>\r\n                </div>\r\n\r\n                <table class=\"test-table\">\r\n\r\n                    <thead>\r\n                    <tr>\r\n                        <th>Test Name</th>\r\n                        <th>Unit</th>\r\n                        <th>Min<br>Value</th>\r\n                        <th>Max<br>Value</th>\r\n                        <th>Description</th>\r\n                        <th class=\"actions-col\">Actions</th>\r\n                    </tr>\r\n                    </thead>\r\n\r\n                    <tbody>\r\n\r\n                    <!-- Thymeleaf data -->\r\n                    <tr th:each=\"test, iter : ${testList}\">\r\n                        <td>\r\n                            <div class=\"test-name-cell\">\r\n\r\n                                <div class=\"test-icon\">\r\n                                    <i th:if=\"${iter.index % 3 == 0}\" class=\"fa-solid fa-droplet\"></i>\r\n                                    <i th:if=\"${iter.index % 3 == 1}\" class=\"fa-solid fa-flask\"></i>\r\n                                    <i th:if=\"${iter.index % 3 == 2}\" class=\"fa-regular fa-heart\"></i>\r\n                                </div>\r\n\r\n                                <strong th:text=\"${test.name}\">\r\n                                    HbA1c\r\n                                </strong>\r\n\r\n                            </div>\r\n                        </td>\r\n\r\n                        <td th:text=\"${test.unit}\">%</td>\r\n\r\n                        <td th:text=\"${test.minValue}\">4.0</td>\r\n\r\n                        <td th:text=\"${test.maxValue}\">5.6</td>\r\n\r\n                        <td class=\"description\"\r\n                            th:text=\"${test.description}\">\r\n                            Glycated Hemoglobin diagnostic for long-term...\r\n                        </td>\r\n\r\n                        <td>\r\n                            <div class=\"row-actions\">\r\n                                <button type=\"button\" class=\"row-btn\">\r\n                                    <i class=\"fa-regular fa-eye\"></i>\r\n                                </button>\r\n\r\n                                <button type=\"button\" class=\"row-btn\">\r\n                                    <i class=\"fa-solid fa-pen\"></i>\r\n                                </button>\r\n\r\n                                <form th:action=\"@{/admin/lab-tests/delete/{id}(id=${test.id})}\"\r\n                                      method=\"post\">\r\n                                    <button type=\"submit\" class=\"row-btn delete\">\r\n                                        <i class=\"fa-regular fa-trash-can\"></i>\r\n                                    </button>\r\n                                </form>\r\n                            </div>\r\n                        </td>\r\n                    </tr>\r\n\r\n                    <!-- Demo rows khi chưa có data -->\r\n                    <tr th:if=\"${testList == null || testList.isEmpty()}\">\r\n                        <td>\r\n                            <div class=\"test-name-cell\">\r\n                                <div class=\"test-icon\">\r\n                                    <i class=\"fa-solid fa-droplet\"></i>\r\n                                </div>\r\n                                <strong>HbA1c</strong>\r\n                            </div>\r\n                        </td>\r\n                        <td>%</td>\r\n                        <td>4.0</td>\r\n                        <td>5.6</td>\r\n                        <td class=\"description\">Glycated Hemoglobin diagnostic for long-term...</td>\r\n                        <td></td>\r\n                    </tr>\r\n\r\n                    <tr th:if=\"${testList == null || testList.isEmpty()}\">\r\n                        <td>\r\n                            <div class=\"test-name-cell\">\r\n                                <div class=\"test-icon\">\r\n                                    <i class=\"fa-solid fa-flask\"></i>\r\n                                </div>\r\n                                <strong>Glucose,<br>Fasting</strong>\r\n                            </div>\r\n                        </td>\r\n                        <td>mg/dL</td>\r\n                        <td>70</td>\r\n                        <td>99</td>\r\n                        <td class=\"description\">Blood glucose level after an overnight fast.</td>\r\n                        <td></td>\r\n                    </tr>\r\n\r\n                    <tr th:if=\"${testList == null || testList.isEmpty()}\">\r\n                        <td>\r\n                            <div class=\"test-name-cell\">\r\n                                <div class=\"test-icon\">\r\n                                    <i class=\"fa-regular fa-heart\"></i>\r\n                                </div>\r\n                                <strong>LDL<br>Cholesterol</strong>\r\n                            </div>\r\n                        </td>\r\n                        <td>mg/dL</td>\r\n                        <td>0</td>\r\n                        <td>100</td>\r\n                        <td class=\"description\">Low-density lipoprotein cholesterol (Direct LD...</td>\r\n                        <td></td>\r\n                    </tr>\r\n\r\n                    </tbody>\r\n\r\n                </table>\r\n\r\n            </div>\r\n\r\n            <!-- RESULTS -->\r\n            <div class=\"card tab-content\" id=\"results\">\r\n\r\n                <div class=\"card-header\">\r\n                    <h3>Patient Lab Results</h3>\r\n                </div>\r\n\r\n                <div class=\"empty-state\">\r\n                    No patient lab results yet.\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </section>\r\n\r\n    </main>\r\n\r\n</div>\r\n\r\n<script src=\"/js/lab-tests.js\"\r\n        th:src=\"@{/js/lab-tests.js}\"></script></body>\r\n</html>
