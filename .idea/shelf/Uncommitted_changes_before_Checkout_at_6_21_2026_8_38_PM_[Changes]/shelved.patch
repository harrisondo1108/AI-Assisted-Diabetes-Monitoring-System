                <div class=\"threshold-input-card\">\r\n                        <h4>Cao tuổi</h4>\r\n                        <div class=\"form-row two-col\">\r\n                            <div class=\"form-group\">\r\n                                <label>Min</label>\r\n                                <input type=\"number\" id=\"createElderMin\" min=\"0\" required>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <label>Max</label>\r\n                                <input type=\"number\" id=\"createElderMax\" min=\"0\" required>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"threshold-input-card\">\r\n                        <h4>Người có bầu</h4>\r\n                        <div class=\"form-row two-col\">\r\n                            <div class=\"form-group\">\r\n                                <label>Min</label>\r\n                                <input type=\"number\" id=\"createPregnantMin\" min=\"0\" required>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <label>Max</label>\r\n                                <input type=\"number\" id=\"createPregnantMax\" min=\"0\" required>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n\r\n            <input type=\"hidden\" name=\"minValue\" id=\"createMainMinValue\">\r\n            <input type=\"hidden\" name=\"maxValue\" id=\"createMainMaxValue\">\r\n\r\n            <div class=\"form-group\">\r\n                <label>Description</label>\r\n                <textarea name=\"description\"\r\n                          rows=\"4\"\r\n                          placeholder=\"Enter description...\"></textarea>\r\n            </div>\r\n\r\n            <div class=\