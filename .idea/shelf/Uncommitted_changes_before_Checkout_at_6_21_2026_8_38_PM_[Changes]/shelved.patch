<+><!DOCTYPE html>\r\n<html lang=\"vi\" xmlns:th=\"http://www.thymeleaf.org\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>Medical Tests Management</title>\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\"\r\n          rel=\"stylesheet\">\r\n\r\n    <link rel=\"stylesheet\"\r\n          href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css\">\r\n\r\n    <link rel=\"stylesheet\" th:href=\"@{/css/pages/lab-test-page.css}\">\r\n</head>\r\n\r\n<body>\r\n\r\n<div class=\"page-layout\">\r\n\r\n    <aside class=\"sidebar\">\r\n        <div>\r\n            <div class=\"brand\">\r\n                <h1>Diabetes Care</h1>\r\n                <p>Admin Console</p>\r\n            </div>\r\n\r\n            <nav class=\"nav-menu\">\r\n                <a href=\"#\" class=\"nav-link\">\r\n                    <i class=\"fa-solid fa-chart-line\"></i>\r\n                    <span>Dashboard</span>\r\n                </a>\r\n\r\n                <a href=\"#\" class=\"nav-link\">\r\n                    <i class=\"fa-solid fa-users\"></i>\r\n                    <span>User Management</span>\r\n                </a>\r\n\r\n                <a href=\"#\" class=\"nav-link\">\r\n                    <i class=\"fa-solid fa-pills\"></i>\r\n                    <span>Medicine Management</span>\r\n                </a>\r\n\r\n                <a th:href=\"@{/admin/lab-tests}\" class=\"nav-link active\">\r\n                    <i class=\"fa-solid fa-flask\"></i>\r\n                    <span>Medical Tests</span>\r\n                </a>\r\n\r\n                <a href=\"#\" class=\"nav-link\">\r\n                    <i class=\"fa-solid fa-sliders\"></i>\r\n                    <span>Threshold Config</span>\r\n                </a>\r\n\r\n                <a href=\"#\" class=\"nav-link\">\r\n                    <i class=\"fa-solid fa-desktop\"></i>\r\n                    <span>Monitoring</span>\r\n                </a>\r\n            </nav>\r\n        </div>\r\n\r\n        <div class=\"sidebar-footer\">\r\n            <button type=\"button\" class=\"new-report-btn\">\r\n                <i class=\"fa-solid fa-plus\"></i>\r\n                <span>New Report</span>\r\n            </button>\r\n\r\n            <a href=\"#\" class=\"footer-link\">\r\n                <i class=\"fa-solid fa-gear\"></i>\r\n                <span>Settings</span>\r\n            </a>\r\n\r\n            <a href=\"#\" class=\"footer-link\">\r\n                <i class=\"fa-regular fa-circle-question\"></i>\r\n                <span>Support</span>\r\n            </a>\r\n        </div>\r\n    </aside>\r\n\r\n    <main class=\"main-content\">\r\n\r\n        <header class=\"topbar\">\r\n            <div class=\"search-box\">\r\n                <i class=\"fa-solid fa-magnifying-glass\"></i>\r\n                <input type=\"text\"\r\n                       id=\"tableSearch\"\r\n                       placeholder=\"Tìm theo tên xét nghiệm...\">\r\n            </div>\r\n\r\n            <div class=\"user-area\">\r\n                <button type=\"button\" class=\"notification-btn\">\r\n                    <i class=\"fa-solid fa-bell\"></i>\r\n                    <span class=\"dot\"></span>\r\n                </button>\r\n\r\n                <button type=\"button\" class=\"notification-btn\">\r\n                    <i class=\"fa-solid fa-circle-question\"></i>\r\n                </button>\r\n\r\n                <div class=\"divider\"></div>\r\n\r\n                <div class=\"user-info\">\r\n                    <h4>Quản trị viên</h4>\r\n                    <p>Chief Administrator</p>\r\n                </div>\r\n\r\n                <img src=\"https://i.pravatar.cc/100?img=12\"\r\n                     alt=\"avatar\"\r\n                     class=\"avatar\">\r\n            </div>\r\n        </header>\r\n\r\n        <section class=\"content\">\r\n\r\n            <div th:if=\"${errorMessage != null}\"\r\n                 class=\"alert-error\"\r\n                 th:text=\"${errorMessage}\">\r\n                Tên xét nghiệm đã tồn tại.\r\n            </div>\r\n\r\n            <div class=\"page-header\">\r\n                <div>\r\n                    <h2>Medical Tests Management</h2>\r\n                    <p>Configure diagnostic parameters and manage clinical medical tests.</p>\r\n                </div>\r\n\r\n                <button type=\"button\"\r\n                        class=\"btn btn-primary\"\r\n                        id=\"btnDefineTest\">\r\n                    <i class=\"fa-solid fa-plus\"></i>\r\n                    <span>Define New Test</span>\r\n                </button>\r\n            </div>\r\n\r\n            <div class=\"tabs\">\r\n                <button type=\"button\" class=\"tab active\">Test Catalog</button>\r\n            </div>\r\n\r\n            <div class=\"card\">\r\n\r\n                <div class=\"card-header\">\r\n                    <h3>Test Definitions</h3>\r\n                    <button type=\"button\" class=\"filter-btn\">\r\n                        <i class=\"fa-solid fa-filter\"></i>\r\n                    </button>\r\n                </div>\r\n\r\n                <table class=\"test-table\">\r\n                    <thead>\r\n                    <tr>\r\n                        <th>Test Name</th>\r\n                        <th>Unit</th>\r\n                        <th>Room</th>\r\n                        <th>Status</th>\r\n                        <th class=\"actions-column\">Actions</th>\r\n                    </tr>\r\n                    </thead>\r\n\r\n                    <tbody id=\"labTestTableBody\">\r\n\r\n                    <tr th:each=\"test : ${testList}\">\r\n                        <td>\r\n                            <div class=\"test-info\">\r\n                                <div class=\"test-icon\">\r\n                                    <i class=\"fa-solid fa-vial\"></i>\r\n                                </div>\r\n\r\n                                <strong th:text=\"${test.testName}\">HbA1c</strong>\r\n                            </div>\r\n                        </td>\r\n\r\n                        <td th:text=\"${test.unit}\">%</td>\r\n\r\n                        <td th:text=\"${test.roomId}\">1</td>\r\n\r\n                        <td>\r\n                            <span th:class=\"${test.status} ? 'status-badge active' : 'status-badge inactive'\"\r\n                                  th:text=\"${test.status} ? 'Active' : 'Inactive'\">\r\n                                Active\r\n                            </span>\r\n                        </td>\r\n\r\n                        <td>\r\n                            <div class=\"row-actions\">\r\n\r\n                                <button type=\"button\"\r\n                                        class=\"action-btn view-btn\"\r\n                                        th:attr=\"data-id=${test.labTestId},\r\n                                                 data-name=${test.testName},\r\n                                                 data-unit=${test.unit},\r\n                                                 data-min=${test.minValue},\r\n                                                 data-max=${test.maxValue},\r\n                                                 data-room=${test.roomId},\r\n                                                 data-status=${test.status},\r\n                                                 data-description=${test.description}\">\r\n                                    <i class=\"fa-regular fa-eye\"></i>\r\n                                </button>\r\n\r\n                                <button type=\"button\"\r\n                                        class=\"action-btn edit-btn\"\r\n                                        th:attr=\"data-id=${test.labTestId},\r\n                                                 data-name=${test.testName},\r\n                                                 data-unit=${test.unit},\r\n                                                 data-min=${test.minValue},\r\n                                                 data-max=${test.maxValue},\r\n                                                 data-room=${test.roomId},\r\n                                                 data-description=${test.description}\">\r\n                                    <i class=\"fa-solid fa-pen\"></i>\r\n                                </button>\r\n\r\n                                <form th:action=\"@{/admin/lab-tests/toggle-status/{id}(id=${test.labTestId})}\"\r\n                                      method=\"post\"\r\n                                      class=\"lock-form\">\r\n                                    <button type=\"submit\"\r\n                                            class=\"action-btn lock-btn\"\r\n                                            th:title=\"${test.status} ? 'Deactivate' : 'Activate'\">\r\n                                        <i th:class=\"${test.status} ? 'fa-solid fa-lock-open' : 'fa-solid fa-lock'\"></i>\r\n                                    </button>\r\n                                </form>\r\n\r\n                            </div>\r\n                        </td>\r\n                    </tr>\r\n\r\n                    <tr th:if=\"${testList == null || testList.isEmpty()}\">\r\n                        <td colspan=\"5\" class=\"empty-row\">\r\n                            Chưa có dữ liệu xét nghiệm.\r\n                        </td>\r\n                    </tr>\r\n\r\n                    </tbody>\r\n                </table>\r\n\r\n                <div class=\"pagination-wrapper\">\r\n                    <div class=\"pagination-info\" id=\"paginationInfo\">\r\n                        Hiển thị 0 - 0 / 0 xét nghiệm\r\n                    </div>\r\n\r\n                    <div class=\"pagination-buttons\">\r\n                        <button type=\"button\" id