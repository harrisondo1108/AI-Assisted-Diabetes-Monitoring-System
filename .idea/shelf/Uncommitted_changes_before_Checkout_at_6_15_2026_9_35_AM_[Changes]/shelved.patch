                <div class=\"threshold-input-card\">\r\n                        <h4>Cao tuổi</h4>\r\n                        <div class=\"form-row two-col\">\r\n                            <div class=\"form-group\">\r\n                                <label>Min</label>\r\n                                <input type=\"number\" id=\"createElderMin\" min=\"0\" required>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <label>Max</label>\r\n                                <input type=\"number\" id=\"createElderMax\" min=\"0\" required>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"threshold-input-card\">\r\n                        <h4>Người có bầu</h4>\r\n                        <div class=\"form-row two-col\">\r\n                            <div class=\"form-group\">\r\n                                <label>Min</label>\r\n                                <input type=\"number\" id=\"createPregnantMin\" min=\"0\" required>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <label>Max</label>\r\n                                <input type=\"number\" id=\"createPregnantMax\" min=\"0\" required>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n\r\n            <input type=\"hidden\" name=\"minValue\" id=\"createMainMinValue\">\r\n            <input type=\"hidden\" name=\"maxValue\" id=\"createMainMaxValue\">\r\n\r\n            <div class=\"form-group\">\r\n                <label>Description</label>\r\n                <textarea name=\"description\"\r\n                          rows=\"4\"\r\n                          placeholder=\"Enter description...\"></textarea>\r\n            </div>\r\n\r\n            <div class=\"modal-actions\">\r\n                <button type=\"button\"\r\n                        class=\"btn-cancel\"\r\n                        id=\"btnCancelModal\">\r\n                    Cancel\r\n                </button>\r\n\r\n                <button type=\"submit\"\r\n                        class=\"btn-save\">\r\n                    Save Test\r\n                </button>\r\n            </div>\r\n        </form>\r\n    </div>\r\n</div>\r\n\r\n<!-- EDIT MODAL -->\r\n<div class=\"modal-overlay\" id=\"editTestModal\">\r\n    <div class=\"modal-box large-modal-box\">\r\n\r\n        <div class=\"modal-header\">\r\n            <h2>Edit Medical Test</h2>\r\n\r\n            <button type=\"button\"\r\n                    class=\"modal-close\"\r\n                    id=\"btnCloseEditModal\">\r\n                <i class=\"fa-solid fa-xmark\"></i>\r\n            </button>\r\n        </div>\r\n\r\n        <form id=\"editTestForm\"\r\n              method=\"post\"\r\n              class=\"modal-form\">\r\n\r\n            <div class=\"form-group\">\r\n                <label>Lab Test ID</label>\r\n                <input type=\"text\"\r\n                       id=\"editLabTestId\"\r\n                       disabled>\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n                <label>Test Name</label>\r\n                <input type=\"text\"\r\n                       id=\"editTestName\"\r\n                       name=\"testName\"\r\n                       maxlength=\"100\"\r\n                       required>\r\n            </div>\r\n\r\n            <div class=\"form-row two-col\">\r\n                <div class=\"form-group\">\r\n                    <label>Unit</label>\r\n                    <input type=\"text\"\r\n                           id=\"editUnit\"\r\n                           name=\"unit\"\r\n                           maxlength=\"20\"\r\n                           required>\r\n                </div>\r\n\r\n                <div class=\"form-group\">\r\n                    <label>Room</label>\r\n                    <select id=\"editRoomId\" name=\"roomId\" required>\r\n                        <option value=\"\">-- Chọn phòng xét nghiệm --</option>\r\n                        <option th:each=\"room : ${roomList}\"\r\n                                th:value=\"${room.roomId}\"\r\n                                th:text=\"${room.roomName}\">\r\n                            Room 1\r\n                        </option>\r\n                    </select>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"threshold-input-section\">\r\n                <label class=\"section-label\">\r\n                    Config Min - Max theo từng nhóm bệnh nhân\r\n                </label>\r\n\r\n                <div class=\"threshold-input-grid\">\r\n\r\n                    <div class=\"threshold-input-card\">\r\n                        <h4>Người trẻ</h4>\r\n                        <div class=\"form-row two-col\">\r\n                            <div class=\"form-group\">\r\n                                <label>Min</label>\r\n                                <input type=\"number\" id=\"editYoungMin\" min=\"0\" required>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <label>Max</label>\r\n                                <input type=\"number\" id=\"editYoungMax\" min=\"0\" required>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"threshold-input-card\">\r\n                        <h4>Trung niên</h4>\r\n                        <div class=\"form-row two-col\">\r\n                            <div class=\"form-group\">\r\n                                <label>Min</label>\r\n                                <input type=\"number\" id=\"editMiddleMin\" min=\"0\" required>\r\n                            </div>\r\n                            <div 