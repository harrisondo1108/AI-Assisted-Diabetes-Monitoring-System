group\">\r\n                <label>Description</label>\r\n                <textarea id=\"editDescription\"\r\n                          name=\"description\"\r\n                          rows=\"4\"></textarea>\r\n            </div>\r\n\r\n            <div class=\"modal-actions\">\r\n                <button type=\"button\"\r\n                        class=\"btn-cancel\"\r\n                        id=\"btnCancelEditModal\">\r\n                    Cancel\r\n                </button>\r\n\r\n                <button type=\"submit\"\r\n                        class=\"btn-save\">\r\n                    Update Test\r\n                </button>\r\n            </div>\r\n        </form>\r\n    </div>\r\n</div>\r\n\r\n<!-- VIEW DETAIL MODAL -->\r\n<div class=\"modal-overlay\" id=\"viewDetailModal\">\r\n    <div class=\"modal-box detail-modal-box\">\r\n\r\n        <div class=\"modal-header\">\r\n            <h2>Medical Test Detail</h2>\r\n\r\n            <button type=\"button\"\r\n                    class=\"modal-close\"\r\n                    id=\"btnCloseViewModal\">\r\n                <i class=\"fa-solid fa-xmark\"></i>\r\n            </button>\r\n        </div>\r\n\r\n        <div class=\"detail-container\">\r\n\r\n            <div class=\"detail-row\">\r\n                <div class=\"detail-item\">\r\n                    <label>Lab Test ID</label>\r\n                    <p id=\"detailId\">---</p>\r\n                </div>\r\n\r\n                <div class=\"detail-item\">\r\n                    <label>Test Name</label>\r\n                    <p id=\"detailName\">---</p>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n                <div class=\"detail-item\">\r\n                    <label>Unit</label>\r\n                    <p id=\"detailUnit\">---</p>\r\n                </div>\r\n\r\n                <div class=\"detail-item\">\r\n                    <label>Room ID</label>\r\n                    <p id=\"detailRoom\">---</p>\r