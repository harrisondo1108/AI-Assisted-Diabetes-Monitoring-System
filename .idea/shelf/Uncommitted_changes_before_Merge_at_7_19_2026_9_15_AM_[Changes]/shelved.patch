onJson\" value=\"\">\r\n                    <input type=\"hidden\" id=\"symptomCommentsJson\" name=\"symptomCommentsJson\" value=\"\">\r\n                    <input type=\"hidden\" id=\"labResultsJson\" name=\"labResultsJson\" value=\"\">\r\n                    <div class=\"workspace-header\">\r\n                        <!-- Diagnostic Session Status -->\r\n                        <div class=\"session-info\" style=\"display: none;\">\r\n                            <span class=\"session-label\">Session ID:</span>\r\n                            <span class=\"session-id\">EXAM-2026-9923</span>\r\n                        </div>\r\n                        <!-- Top actions -->\r\n                        <div class=\"workspace-actions\">\r\n                            <button type=\"button\" class=\"btn btn-outline-danger\" onclick=\"cancelExam()\">Hủy ca khám</button>\r\n                            <button type=\"button\" class=\"btn btn-primary\" onclick=\"saveExam()\"><i\r\n                                    class=\"fas fa-floppy-disk\"></i> Hoàn thành khám bệnh</button>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- Examination Start Overlay -->\r\n                    <div id=\"examStartOverlay\" class=\"exam-start-overlay\" th:style=\"${activeExam != null && activeExam.status == 'Pending' ? 'display: flex;' : 'display: none;'}\">\r\n                        <i class=\"fas fa-stethoscope\"></i>\r\n                        <h3>Bắt đầu khám lâm sàng</h3>\r\n                        <p>Bạn chuẩn bị bắt đầu ca khám cho bệnh nhân <strong th:text=\"${patient.fullName}\">this patient</strong></p>\r\n                        <button type=\"submit\" form=\"startExamForm\" class=\"btn btn-primary\" style=\"font-size: 1.1rem; padding: 12px 24px;\">\r\n                            <i class=\"fas fa-play\"></i> Bắt đầu khám\r\n                        </button>\r\n                    </div>\r\n\r\n                    <!-- SECTION 1: Symptoms Checklist -->\r\n                    <div class=\"workspace-section\" id=\"symptoms-section\">\r\n                        <div class=\"form-section\">\r\n                            <p class=\"section-description\">Chọn triệu chứng của bệnh nhân và ghi chú tiền sử/bệnh sử lâm sàng</p>\r\n\r\n                            <!-- Pregnant classification checkbox for Female patients -->\r\n                            <div th:if=\"${patient.gender}\" class=\"pregnant-toggle-container\" style=\"margin: 12px 0 16px 0; padding: 10px 14px; background: rgba(220, 38, 38, 0.05); border-radius: 8px; border: 1px dashed rgba(220, 38, 38, 0.2); display: flex; align-items: center; gap: 8px; width: fit-content;\">\r\n                                <input type=\"checkbox\" id=\"isPregnant\" th:field=\"*{isPregnant}\" style=\"width: 18px; height: 18px; cursor: pointer;\" />\r\n                                <label for=\"isPregnant\" style=\"font-weight: 600; margin-bottom: 0; color: var(--doctor-danger); cursor: pointer; display: flex; align-items: center; gap: 6px;\">\r\n                                    <i class=\"fas fa-person-pregnant\"></i> Bệnh nhân đang mang thai\r\n                                </label>\r\n                            </div>\r\n\r\n                            <div class=\"form-grid-columns-2\">\r\n                                <div class=\"form-group full-width\">\r\n                                    <label for=\"examHistory\">Lý do khám & Bệnh sử hiện tại <span class=\"required\">*</span></label>\r\n                                    <textarea id=\"examHistory\" th:field=\"*{medicalHistory}\" rows=\"3\"\r\n                                        placeholder=\"Nhập mô tả của bệnh nhân về triệu chứng, thời gian và hoàn cảnh xuất hiện...\"\r\n                                        th:classappend=\"${#fields.hasErrors('medicalHistory')} ? 'is-invalid' : ''\"></textarea>\r\n                                    <div class=\"error-feedback\" th:if=\"${#fields.hasErrors('medicalHistory')}\" th:errors=\"*{medicalHistory}\"></div>\r\n                                </div>\r\n                                <div class=\"form-group\">\r\n                                    <label for=\"examNextDate\">Hẹn ngày tái khám</label>\r\n                                    <input type=\"date\" id=\"examNextDate\" th:field=\"*{nextAppointment}\">\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"form-section\" style=\"margin-top: 20px;\">\r\n                            <h3 class=\"section-header-title\">Danh mục phân loại triệu chứng <span class=\"required\">*</span></h3>\r\n                            <div class=\"error-feedback\" th:if=\"${#fields.hasErrors('symptomIds')}\" th:errors=\"*{symptomIds}\"></div>\r\n                            <div class=\"symptoms-selection-grid\" id=\"symptomsGrid\">\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- SECTION 2: Lab Orders -->\r\n                    <div class=\"workspace-section\" id=\"labs-section\">\r\n                        <div class=\"form-section\">\r\n                            <div class=\"prescription-header\">\r\n                                <div class=\"prescription-titles\">\r\n                                    <p class=\"section-description\">Chỉ định các xét nghiệm cận lâm sàng cho bệnh nhân</p>\r\n                                </div>\r\n                                <button type=\"button\" class=\"btn btn-secondary btn-sm\" onclick=\"assignAllLabTests()\"><i\r\n                                        class=\"fas fa-flask\"></i> Chỉ định nhanh toàn bộ xét nghiệm</button>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"form-section\" style=\"margin-top: 20px;\">\r\n                            <div class=\"card\">\r\n                                <div class=\"card-header\">\r\n                                    <span class=\"badge-status badge-completed\"><i class=\"fas fa-vial\"></i> Kết quả xét nghiệm cận lâm sàng </span>\r\n                                </div>\r\n                                <div class=\"table-container\">\r\n                                    <table class=\"clinical-table\">\r\n                                        <thead>\r\n                                            <tr>\r\n                                                <th>Tên xét nghiệm</th>\r\n                                                <th>Ngưỡng so sánh</th>\r\n                                                <th>Kết quả</th>\r\n                                                <th>Trạng thái</th>\r\n                                            </tr>\r\n                                        </thead>\r\n                                        <tbody id=\"labResultsTableBody\">\r\n                                            <tr>\r\n                                                <td colspan=\"4\"\r\n                                                    style=\"text-align: center; color: var(--doctor-text-muted); padding: 30px;\">\r\n                                                    Vui lòng chỉ định một hoặc nhiều xét nghiệm từ danh mục phía trên để xem kết quả\r\n                                                </td>\r\n                                            </tr>\r\n                                        </tbody>\r\n                                    </table>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- SECTION: Diagnosis Note -->\r\n                    <div class=\"workspace-section\" id=\"diagnosis-section\">\r\n                        <div class=\"form-section\">\r\n                            <h3 class=\"section-header-title\"><i class=\"fas fa-comment-medical\"></i> Chẩn đoán lâm sàng <span class=\"required\">*</span></h3>\r\n                            <p class=\"section-description\">Nhập chẩn đoán lâm sàng và ghi chú chi tiết cho ca khám này</p>\r\n                            <div class=\"form-group full-width\" style=\"margin-top: 15px;\">\r\n                                <textarea id=\"examDiagnosis\" th:field=\"*{diagnosisNote}\" rows=\"3\"\r\n                                    placeholder=\"Nhập chẩn đoán lâm sàng và ghi chú...\"\r\n                                    th:classappend=\"${#fields.hasErrors('diagnosisNote')} ? 'is-invalid' : ''\"></textarea>\r\n                                <div class=\"error-feedback\" th:if=\"${#fields.hasErrors('diagnosisNote')}\" th:errors=\"*{diagnosisNote}\"></div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- TAB CONTENT 3: Treatment & Prescription -->\r\n                    <!-- SECTION 3: Treatment & Prescription -->\r\n                    <div class=\"workspace-section\" id=\"prescription-section\">\r\n                        <!-- Treatment Plan Form Section -->\r\n                        <div class=\"form-section\" style=\"margin-bottom: 20px;\">\r\n                            <h3 class=\"section-header-title\"><i class=\"fas fa-notes-medical\"\r\n                                    style=\"color: var(--doctor-primary);\"></i> Kế hoạch & Phác đồ điều trị <span class=\"required\">*</span></h3>\r\n                            <p class=\"section-description\" style=\"margin-bottom: 15px;\">Kế hoạch điều trị bao gồm mục tiêu, dinh dưỡng, vận động, tự theo dõi và hướng dẫn sử dụng thuốc (yêu cầu ít nhất 1 trường)</p>\r\n\r\n                            <div class=\"form-grid-columns-2\">\r\n                                <div class=\"form-group full-width\">\r\n                                    <label for=\"planGoal\">Mục tiêu điều trị</label>\r\n                                    <input type=\"text\" id=\"planGoal\" th:field=\"*{treatmentGoal}\"\r\n                                        placeholder=\"Ví dụ: Giảm đường huyết lúc đói < 5.6 mmol/L và HbA1c < 6.5%\"\r\n                                        th:classappend=\"${#fields.hasErrors('treatmentGoal')} ? 'is-invalid' : ''\">\r\n                                    <div class=\"error-feedback\" th:if=\"${#fields.hasErrors('treatmentGoal')}\" th:errors=\"*{treatmentGoal}\"></div>\r\n                                </div>\r\n                                <div class=\"form-group\">\r\n                                    <label for=\"planDiet\">Chế độ dinh dưỡng</label>\r\n                                    <textarea id=\"planDiet\" th:field=\"*{dietPlan}\" rows=\"3\"\r\n                                        placeholder=\"Ví dụ: Hạn chế đường, tinh bột, ăn nhiều thực phẩm giàu chất xơ...\"></textarea>\r\n                                </div>\r\n                                <div class=\"form-group\">\r\n                                    <label for=\"planExercise\">Chế độ vận động & Tập luyện</label>\r\n                                    <textarea id=\"planExercise\" th:field=\"*{exercisePlan}\" rows=\"3\"\r\n                                        placeholder=\"Ví dụ: Đi bộ hoặc chạy bộ 30 phút mỗi ngày, 5 lần một tuần...\"></textarea>\r\n                                </div>\r\n                                <div class=\"form-group\">\r\n                                    <label for=\"planGlucose\">Tần suất tự theo dõi đường huyết</label>\r\n                                    <textarea id=\"planGlucose\" th:field=\"*{glucoseMonitoringPlan}\" rows=\"3\"\r\n                                        placeholder=\"Ví dụ: Đo đường huyết lúc đói vào buổi sáng và 2 giờ sau khi ăn trưa...\"></textarea>\r\n                                </div>\r\n\r\n                            </div>\r\n                        </div>\r\n\r\n                        <!-- Medication Prescription Section -->\r\n                        <div class=\"form-section\">\r\n                            <h3 class=\"section-header-title\"><i class=\"fas fa-prescription-bottle-medical\"\r\n                                    style=\"color: var(--doctor-primary);\"></i> Đơn thuốc điều trị <span class=\"required\">*</span></h3>\r\n                            <div class=\"error-feedback\" th:if=\"${#fields.hasErrors('prescriptionJson')}\" th:errors=\"*{prescriptionJson}\"></div>\r\n                            <div class=\"prescription-header\"\r\n                                style=\"border-bottom: none; margin-bottom: 0; padding-bottom: 0; margin-top: 10px;\">\r\n                                <div class=\"prescription-titles\">\r\n                                    <p class=\"section-description\">Thêm các loại thuốc điều trị, nồng độ/hàm lượng, số lượng cung cấp và thời điểm sử dụng</p>\r\n                                </div>\r\n                                <button type=\"button\" class=\"btn btn-secondary btn-sm\"\r\n                                    onclick=\"showMedicationModal()\"><i class=\"fas fa-plus\"></i> Kê đơn thuốc</button>\r\n                            </div>\r\n\r\n                            <div class=\"prescription-items-list\" id=\"prescriptionLines\" style=\"margin-top: 15px;\">\r\n                                <!-- Dynamic prescription detail rows loaded via JS -->\r\n                                <div class=\"no-medications-message\" id=\"emptyPrescription\">\r\n                                    <i class=\"fas fa-prescription-bottle-medical\"></i>\r\n                                    <p>Chưa có thuốc nào được kê trong đơn thuốc này.</p>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                </form>\r\n                <!-- Hidden Start Examination Form to avoid nested form tags -->\r\n                <form th:action=\"@{/doctor/examine/{id}/start(id=${patient.userId})}\" method=\"POST\" id=\"startExamForm\" style=\"display: none;\"></form>\r\n            </main>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- MEDICATION DIALOG MODAL -->\r\n    <div class=\"modal-overlay\" id=\"medicationModal\">\r\n        <div class=\"modal modal-prescription\">\r\n            <div class=\"modal-header\">\r\n                <h2>Kê đơn thuốc</h2>\r\n                <button type=\"button\" class=\"modal-close\" onclick=\"closeMedicationModal()\"><i\r\n                        class=\"fas fa-times\"></i></button>\r\n            </div>\r\n            <div class=\"modal-body\">\r\n                <div class=\"form-group\">\r\n                    <label style=\"font-weight: 600; display: flex; align-items: center; gap: 6px;\">\r\n                        <i class=\"fas fa-prescription-bottle-medical\" style=\"color: var(--doctor-primary);\"></i> Chọn thuốc <span class=\"required\">*</span>\r\n                    </label>\r\n                    <div class=\"custom-select-autocomplete\">\r\n                        <i class=\"fas fa-search autocomplete-search-icon\"></i>\r\n                        <input type=\"text\" id=\"medSearch\" placeholder=\"Nhập tên thuốc hoặc hàm lượng để tìm kiếm...\"\r\n                            onkeyup=\"filterMedications()\">\r\n                        <div class=\"autocomplete-list\" id=\"medAutocompleteList\">\r\n                            <!-- Populated dynamically -->\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n                <div class=\"med-details-container\" id=\"medDetailFields\" style=\"display: none;\">\r\n                    <!-- Selected Medication Info Banner -->\r\n                    <div class=\"selected-med-banner\">\r\n                        <div class=\"med-banner-icon\"><i class=\"fas fa-pills\"></i></div>\r\n                        <div class=\"med-banner-details\">\r\n                            <h4 id=\"medBannerName\">Tên thuốc</h4>\r\n                            <p id=\"medBannerForm\">Dạng bào chế / Đường dùng</p>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"med-details-grid\">\r\n                        <!-- Left Panel: Duration & Dates -->\r\n                        <div class=\"med-details-panel\">\r\n                            <div class=\"panel-title\">\r\n                                <i class=\"far fa-calendar-alt\"></i> Thời gian &amp; Liệu trình\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <label style=\"font-weight: 600; display: flex; align-items: center; gap: 6px;\">\r\n                                    <i class=\"fas fa-calendar-day\"></i> Số ngày sử dụng <span class=\"required\">*</span>\r\n                                </label>\r\n                                <input type=\"number\" id=\"medDuration\" min=\"1\" max=\"180\" value=\"30\" style=\"width: 100%; box-sizing: border-box;\">\r\n                                <span class=\"error-msg\" id=\"error-medDuration\"></span>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <label style=\"font-weight: 600; display: flex; align-items: center; gap: 6px;\">\r\n                                    <i class=\"fas fa-calendar-plus\"></i> Ngày bắt đầu <span class=\"required\">*</span>\r\n                                </label>\r\n                                <input type=\"date\" id=\"medStartDate\" style=\"width: 100%; box-sizing: border-box;\">\r\n                                <span class=\"error-msg\" id=\"error-medStartDate\"></span>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <label style=\"font-weight: 600; display: flex; align-items: center; gap: 6px;\">\r\n                                    <i class=\"fas fa-calendar-check\"></i> Ngày kết thúc dự kiến\r\n                                </label>\r\n                                <div class=\"readonly-date-wrapper\">\r\n                                    <input type=\"date\" id=\"medEndDate\" readonly style=\"width: 100%; box-sizing: border-box;\">\r\n                                    <i class=\"fas fa-lock lock-icon\" title=\"Ngày kết thúc được tự động tính dựa trên ngày bắt đầu và số ngày sử dụng\"></i>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <!-- Right Panel: Quantity, Timing & Advice -->\r\n                        <div class=\"med-details-panel\">\r\n                            <div class=\"panel-title\">\r\n                                <i class=\"fas fa-hand-holding-medical\"></i> Liều lượng &amp; Chỉ dẫn\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <label style=\"font-weight: 600; display: flex; align-items: center; gap: 6px;\">\r\n                                    <i class=\"fas fa-capsules\"></i> Liều dùng mỗi lần <span class=\"required\">*</span>\r\n                                </label>\r\n                                <input type=\"number\" id=\"medDosage\" min=\"0.1\" step=\"0.1\" value=\"1\" placeholder=\"Nhập liều dùng mỗi lần...\" style=\"width: 100%; box-sizing: border-box;\">\r\n                                <span class=\"error-msg\" id=\"error-medDosage\"></span>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <label style=\"font-weight: 600; display: flex; align-items: center; gap: 6px;\">\r\n                                    <i class=\"fas fa-clipboard-list\"></i> Tổng số lượng cấp <span class=\"required\">*</span>\r\n                                </label>\r\n                                <div class=\"readonly-date-wrapper\">\r\n                                    <input type=\"number\" id=\"medQuantity\" min=\"1\" max=\"500\" value=\"30\" readonly style=\"width: 100%; box-sizing: border-box;\">\r\n                                    <i class=\"fas fa-lock lock-icon\" title=\"Số lượng cấp tự động tính = Liều dùng mỗi lần * Số lần dùng/ngày * Số ngày dùng\"></i>\r\n                                </div>\r\n                                <span class=\"error-msg\" id=\"error-medQuantity\"></span>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                 <label style=\"font-weight: 600; display: flex; align-items: center; justify-content: space-between; gap: 6px; width: 100%;\">\r\n                                     <span><i class=\"fas fa-clock\"></i> Thời điểm sử dụng <span class=\"required\">*</span></span>\r\n                                 </label>\r\n                                 <div class=\"custom-multiselect-container\" id=\"medTimingContainer\">\r\n                                     <div class=\"custom-multiselect-header\" onclick=\"toggleTimingDropdown(event)\">\r\n                                         <span id=\"medTimingPlaceholder\">Chọn thời điểm...</span>\r\n                                         <i class=\"fas fa-chevron-down\"></i>\r\n                                     </div>\r\n                                     <div class=\"custom-multiselect-options\" id=\"medTimingOptions\">\r\n                                         <div class=\"custom-multiselect-option\" th:each=\"t : ${medicationTimings}\" th:data-value=\"${t.timingName}\" onclick=\"selectTimingOption(this, event)\">\r\n                                             <input type=\"checkbox\" th:id=\"${'timing-' + t.timingID}\" th:value=\"${t.timingName}\" onclick=\"event.stopPropagation(); updateTimingPlaceholder();\">\r\n                                             <label th:for=\"${'timing-' + t.timingID}\" th:text=\"${t.timingName}\" onclick=\"event.stopPropagation()\"></label>\r\n                                         </div>\r\n                                         <!-- Fallbacks if empty -->\r\n                                         <div th:if=\"${medicationTimings == null }\" class=\"custom-multiselect-option\" data-value=\"Breakfast Time (07:30 AM)\" onclick=\"selectTimingOption(this, event)\">\r\n                                             <input type=\"checkbox\" id=\"timing-fb1\" value=\"Breakfast Time (07:30 AM)\" onclick=\"event.stopPropagation(); updateTimingPlaceholder();\">\r\n                                             <label for=\"timing-fb1\" onclick=\"event.stopPropagation()\">Thời điểm ăn sáng (07:30 AM)</label>\r\n                                         </div>\r\n                                         <div th:if=\"${medicationTimings == null }\" class=\"custom-multiselect-option\" data-value=\"Lunch Time (12:15 PM)\" onclick=\"selectTimingOption(this, event)\">\r\n                                             <input type=\"checkbox\" id=\"timing-fb2\" value=\"Lunch Time (12:15 PM)\" onclick=\"event.stopPropagation(); updateTimingPlaceholder();\">\r\n                                             <label for=\"timing-fb2\" onclick=\"event.stopPropagation()\">Thời điểm ăn trưa (12:15 PM)</label>\r\n                                         </div>\r\n                                         <div th:if=\"${medicationTimings == null }\" class=\"custom-multiselect-option\" data-value=\"Dinner Time (07:00 PM)\" onclick=\"selectTimingOption(this, event)\">\r\n                                             <input type=\"checkbox\" id=\"timing-fb3\" value=\"Dinner Time (07:00 PM)\" onclick=\"event.stopPropagation(); updateTimingPlaceholder();\">\r\n                                             <label for=\"timing-fb3\" onclick=\"event.stopPropagation()\">Thời điểm ăn tối (07:00 PM)</label>\r\n                                         </div>\r\n                                     </div>\r\n                                 </div>\r\n                                 <span class=\"error-msg\" id=\"error-medTiming\"></span>\r\n                            </div>\r\n                            <div class=\"form-group\">\r\n                                <label style=\"font-weight: 600; display: flex; align-items: center; gap: 6px;\">\r\n                                    <i class=\"fas fa-file-medical\"></i> Hướng dẫn bổ sung\r\n                                </label>\r\n                                <textarea id=\"medPlan\" rows=\"2\" placeholder=\"Ví dụ: Uống sau khi ăn 30 phút, uống với nhiều nước...\" style=\"width: 100%; box-sizing: border-box;\"></textarea>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"modal-footer\">\r\n                <button type=\"button\" class=\"btn btn-secondary\" onclick=\"closeMedicationModal()\">Hủy</button>\r\n                <button type=\"button\" class=\"btn btn-primary\" id=\"addMedBtn\" onclick=\"addMedicationLine()\">Thêm vào đơn thuốc</button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- CANCEL CONFIRMATION MODAL -->\r\n    <div class=\"modal-overlay\" id=\"cancelConfirmModal\">\r\n        <div class=\"modal\" style=\"max-width: 420px; padding: 20px; border-radius: 12px;\">\r\n            <form th:action=\"@{/doctor/examine/{id}/cancel(id=${patient.userId})}\" method=\"POST\" id=\"cancelForm\">\r\n                <div class=\"modal-header\" style=\"border-bottom: none; padding-bottom: 0;\">\r\n                    <h3 style=\"font-size: 1.15rem; font-weight: 700; color: var(--doctor-text-main);\">Hủy ca khám</h3>\r\n                    <button type=\"button\" class=\"close-btn\" onclick=\"closeCancelModal()\" style=\"font-size: 1.2rem;\"><i\r\n                            class=\"fas fa-times\"></i></button>\r\n                </div>\r\n                <div class=\"modal-body\" style=\"text-align: center; padding: 15px 10px 10px 10px;\">\r\n                    <i class=\"fas fa-exclamation-triangle\"\r\n                        style=\"font-size: 2.8rem; color: var(--doctor-danger); margin-bottom: 15px;\"></i>\r\n                    <p\r\n                        style=\"font-size: 1.05rem; font-weight: 600; color: var(--doctor-text-main); margin-bottom: 8px; line-height: 1.4;\">\r\n                        Bạn có chắc chắn muốn hủy ca khám này?</p>\r\n                    <p style=\"font-size: 0.85rem; color: var(--doctor-text-muted); margin-bottom: 15px; line-height: 1.4;\">\r\n                        Tất cả tiến trình chưa lưu sẽ bị mất vĩnh viễn</p>\r\n                    <div style=\"margin-top: 12px; text-align: left;\">\r\n                        <label\r\n                            style=\"font-weight: 600; font-size: 0.8rem; color: var(--doctor-text-main); display: block; margin-bottom: 5px;\">Lý do hủy\r\n                            <span class=\"required\" style=\"color: var(--doctor-danger);\">*</span></label>\r\n                        <textarea id=\"cancelReason\" name=\"reason\" rows=\"2\" placeholder=\"Vui lòng nêu rõ lý do hủy...\" required\r\n                            style=\"width: 100%; border: 1px solid var(--doctor-border); border-radius: 6px; padding: 8px 10px; font-size: 0.8rem; outline: none; resize: none; box-sizing: border-box; font-family: inherit; line-height: 1.4; transition: border-color 0.2s;\"\r\n                            onfocus=\"this.style.borderColor='var(--doctor-primary)'\"\r\n                            onblur=\"this.style.borderColor='var(--doctor-border)'\"></textarea>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\" style=\"justify-content: center; gap: 12px; padding-top: 10px; border-top: none;\">\r\n                    <button type=\"button\" class=\"btn btn-secondary\" onclick=\"closeCancelModal()\"\r\n                        style=\"font-size: 0.9rem; padding: 8px 18px; border-radius: 6px;\">Không</button>\r\n                    <button type=\"submit\" class=\"btn\"\r\n                        style=\"background: var(--doctor-danger); color: white; font-size: 0.9rem; padding: 8px 18px; border-radius: 6px; font-weight: 600; border: none; cursor: pointer; transition: opacity 0.2s;\"\r\n                        onmouseover=\"this.style.opacity='0.9'\" onmouseout=\"this.style.opacity='1'\">Có, hủy khám</button>\r\n                </div>\r\n            </form>\r\n        </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n    <!-- Script assets -->\r\n    <script th:inline=\"javascript\">\r\n        /*<![CDATA[*/\r\n        const thPatient = /*[[${patientData}]]*/ null;\r\n        const thRoutine = /*[[${routineData}]]*/ null;\r\n        const thActiveExam = /*[[${activeExamData}]]*/ null;\r\n        const thViewOnly = /*[[${viewOnly}]]*/ false;\r\n        const thIsEditMode = /*[[${isEditMode != null ? isEditMode : false}]]*/ false;\r\n        const thLastExam = /*[[${lastExamData}]]*/ null;\r\n        const thChosenSymptomIds = /*[[${chosenSymptomIds}]]*/ [];\r\n        const thChosenSymptomNotes = /*[[${chosenSymptomNotes}]]*/ {};\r\n        const thLastExamLabResults = /*[[${lastExamLabResultsData}]]*/ [];\r\n        const thLastExamPrescriptionDetails = /*[[${lastExamPrescriptionDetailsData}]]*/ [];\r\n        const rawSymptomsCatalog = /*[[${symptomsCatalog}]]*/ [];\r\n        const rawLabTestsCatalog = /*[[${labTestsCatalogData}]]*/ [];\r\n        const rawLabTestsPregnantCatalog = /*[[${labTestsPregnantCatalogData}]]*/ [];\r\n        const rawMedicationsCatalog = /*[[${medicationsCatalogData}]]*/ [];\r\n        /*]]>*/\r\n    </script>\r\n    <script th:src=\"@{/js/doctor/examine.js}\"></script>\r\n</body>\r\n\r\n</html>
