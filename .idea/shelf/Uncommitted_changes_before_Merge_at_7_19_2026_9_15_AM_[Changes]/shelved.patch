<+><!DOCTYPE html>\r\n<html lang=\"vi\" xmlns:th=\"http://www.thymeleaf.org\">\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Phòng khám | Hệ thống Theo dõi Đường huyết</title>\r\n    <!-- Fonts & Icons -->\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap\"\r\n        rel=\"stylesheet\">\r\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\r\n    <!-- Page CSS -->\r\n    <link rel=\"stylesheet\" th:href=\"@{/css/doctor/doctor-common.css}\">\r\n    <link rel=\"stylesheet\" th:href=\"@{/css/doctor/doctor-examine.css}\">\r\n</head>\r\n\r\n<body>\r\n    <div class=\"doctor-layout\">\r\n        <div class=\"doctor-main\">\r\n            <!-- Header layout replacement -->\r\n            <div th:replace=\"~{doctor/doctor_header :: header('Consultation & Diagnostic', 'examine')}\"></div>\r\n\r\n            <main class=\"doctor-content flex-row-container\">\r\n\r\n                <!-- Left Panel: Patient Medical Card (320px) -->\r\n                <aside class=\"patient-medical-card\">\r\n                    <div class=\"patient-card-header\">\r\n                        <div class=\"patient-avatar-large\">\r\n                            <img th:if=\"${patient.imageUrl != null}\" \r\n                                 th:src=\"${patient.imageUrl}\" \r\n                                 alt=\"Avatar\" \r\n                                 style=\"width: 100%; height: 100%; object-fit: cover; border-radius: 50%;\" />\r\n                            <i th:unless=\"${patient.imageUrl != null}\" class=\"fas fa-hospital-user\"></i>\r\n                        </div>\r\n                        <h2 class=\"patient-name-title\" id=\"patName\" th:text=\"${patient.fullName}\"></h2>\r\n                        <span class=\"patient-id-badge\" id=\"patId\" style=\"display: none;\" th:text=\"${patient.userId}\">P012932</span>\r\n                    </div>\r\n\r\n                    <div class=\"patient-specs-grid\">\r\n                        <div class=\"spec-item\">\r\n                            <span class=\"spec-label\">Tuổi</span>\r\n                            <span class=\"spec-val\" id=\"patAge\" th:text=\"${patient.dob != null ? (T(java.time.Period).between(patient.dob, T(java.time.LocalDate).now()).getYears() + ' tuổi') : 'N/A'}\"></span>\r\n                        </div>\r\n                        <div class=\"spec-item\">\r\n                            <span class=\"spec-label\">Giới tính</span>\r\n                            <span class=\"spec-val\" id=\"patGender\" th:text=\"${patient.gender != null ? (patient.gender ? 'Nữ' : 'Nam') : 'N/A'}\"></span>\r\n                        </div>\r\n                        <div class=\"spec-item\">\r\n                            <span class=\"spec-label\">Nhóm máu</span>\r\n                            <span class=\"spec-val\" id=\"patBlood\" th:text=\"${patient.bloodgroup != null ? patient.bloodgroup : 'N/A'}\">O+</span>\r\n                        </div>\r\n                        <div class=\"spec-item\">\r\n                            <span class=\"spec-label\">BMI</span>\r\n                            <span class=\"spec-val\" id=\"patBmi\" th:with=\"h_m=${patient.height != null ? patient.height / 100.0 : 0.0}, bmi=${(patient.weight != null && h_m > 0) ? (patient.weight.doubleValue() / (h_m * h_m)) : 0.0}\" th:text=\"${bmi > 0 ? #numbers.formatDecimal(bmi, 1, 1) + (bmi < 18.5 ? ' (Thiếu cân)' : (bmi < 25.0 ? ' (Bình thường)' : (bmi < 30.0 ? ' (Thừa cân)' : ' (Béo phì)'))) : 'N/A'}\"></span>\r\n                        </div>\r\n                    </div>\r\n\r\n\r\n                    <div class=\"medical-details-section\">\r\n                        <h4 class=\"section-title\"><i class=\"fas fa-weight-scale\"></i> Chỉ số cơ thể</h4>\r\n                        <div class=\"detail-row\">\r\n                            <span>Chiều cao:</span> <strong id=\"patHeight\" th:text=\"${patient.height != null ? patient.height + ' cm' : 'N/A'}\"></strong>\r\n                        </div>\r\n                        <div class=\"detail-row\">\r\n                            <span>Cân nặng:</span> <strong id=\"patWeight\" th:text=\"${patient.weight != null ? patient.weight + ' kg' : 'N/A'}\"></strong>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"medical-details-section\">\r\n                        <h4 class=\"section-title\"><i class=\"fas fa-circle-exclamation\"></i> Cảnh báo y tế</h4>\r\n                        <div class=\"alert-box alert-danger\">\r\n                            <strong>Dị ứng:</strong>\r\n                            <p id=\"patAllergy\" th:text=\"${patient.allergyNotes != null ? patient.allergyNotes : 'Không có dị ứng thuốc nào được ghi nhận'}\"></p>\r\n                        </div>\r\n                        <div class=\"alert-box alert-info\">\r\n                            <strong>Tiền sử bệnh án:</strong>\r\n                            <p id=\"patHistory\" th:text=\"${patient.permanentMedicalHistory != null  ? patient.permanentMedicalHistory : 'Không có tiền sử bệnh án được ghi nhận'}\"></p>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"medical-details-section\">\r\n                        <h4 class=\"section-title\"><i class=\"fas fa-clock\"></i> Sinh hoạt hàng ngày</h4>\r\n                        <div class=\"routine-item\">\r\n                            <i class=\"fas fa-mug-saucer\"></i> <span>Bữa sáng:</span> <strong id=\"patBreakfast\" th:text=\"${routine != null && routine.breakfastTime != null ? #temporals.format(routine.breakfastTime, 'hh:mm a') : 'N/A'}\"></strong>\r\n                        </div>\r\n                        <div class=\"routine-item\">\r\n                            <i class=\"fas f